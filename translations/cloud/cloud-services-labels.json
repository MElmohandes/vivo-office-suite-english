  "routes": [
    "/contacts",
    "/browser",
    "/messageIntercept"
  ],
  "safeSelectors": [
    ".logo-title h2",
    ".operatelist .menubar",
    ".left-menu-list > .left-menu-item > p",
    ".left-menu-list > .sub-menu-item > .left-menu-item > p",
    ".itemlist > .itemcontent > p:not(.textoverflow)",
    ".listLoading .content p",
    ".row-loading span",
    ".no-data p",
    ".searchEmpty p",
    ".button-list .button",
    ".select-all-area",
    ".leftSelect span",
    ".operateBox > span",
    ".footer-action button",
    ".dialog-content-ui .title",
    ".dialog-content-ui .action .btn",
    ".dialog-content-ui .prompt > p.word-break",
    ".dialog-content-ui .newGroup",
    ".dialog-content-ui .prompt .seek",
    ".dialog-content-ui .error",
    ".contact-content-eidt .header.edit",
    ".contact-content-eidt .j_add",
    ".contact-content-eidt .j_option",
    ".contact-content-eidt .j_option li",
    ".contact-content-eidt .j_groupSwitch",
    ".contact-content-eidt .j_addGroup",
    ".contact-content-eidt input.userName + p",
    ".datepicker__button-cancel",
    ".datepicker__button-select",
    "[class*=\"datepicker\"][class$=\"-title\"]",
    "[class*=\"datepicker\"][class$=\"-week\"]",
    "[class*=\"datepicker\"][class$=\"-month-select\"]",
    ".ivu-message-content",
    ".ivu-notice-notice-description",
    ".el-message__content",
    ".toast",
    ".timeago",
    ".content-card-wrapper .source",
    ".calendar-week",
    ".calendar-month-select",
    ".calendar-title",
    ".calendar-months a",
    ".contact-content-eidt .main li > p:not(.j_groupSwitch)",
    ".contact-body .main .describe",
    ".contact-body .main .category"
  ],
  "excludeSelectors": [
    "input",
    "textarea",
    "[contenteditable=\"true\"]",
    "script",
    "style",
    "code",
    "pre",
    ".contentArea",
    ".cardDetail > span",
    ".isMulti .main",
    ".contact-body .telephone",
    ".contact-body .value",
    ".contact-body .main li > p",
    ".itemcontent > p.textoverflow",
    ".listContainer ul li p",
    ".listContainer ul li label",
    ".contact-content-eidt .j_group label",
    ".groupname",
    ".content-card-wrapper .title",
    ".content-card-wrapper .audio-time:not(.timeago):not(.source)",
    ".content-card-wrapper .audio-time span:not(.timeago):not(.source)",
    ".vp-foot-copyright-main",
    "#vp-footer-record",
    "#vp-footer-policetext"
  ],
  "attributeRules": {
    "translate": [
      "placeholder",
      "aria-label"
    ],
    "title": "Only on fixed UI controls/import placeholders. Exclude contact and bookmark data titles.",
    "never": [
      "value",
      "href",
      "src",
      "data-*"
    ]
  },
  "patternRules": [
    {
      "selector": ".itemlist > .itemcontent > p:not(.textoverflow)",
      "pattern": "^(所有联系人|最近删除)（(\\d+)）$",
      "replacement": "translated label + \" (\" + count + \")\"",
      "note": "Do not apply to user group p.textoverflow"
    },
    {
      "selector": ".left-menu-list p",
      "pattern": "^号码(黑名单|白名单)(?:（(\\d+)）)?$",
      "replacement": "Blocked numbers or Allowed numbers, preserving optional count"
    },
    {
      "selector": ".select-all-area",
      "pattern": "^全选 已选择(\\d+)项$",
      "replacement": "Select all · Selected $1 items"
    },
    {
      "selector": ".contact-content-eidt .header.edit",
      "pattern": "^(新建|编辑)联系人$",
      "replacement": "New contact or Edit contact"
    },
    {
      "selector": ".contact-body .header.multi",
      "pattern": "^已选择了(\\d+)个联系人$",
      "replacement": "Selected $1 contacts"
    },
    {
      "selector": ".timeago",
      "pattern": "^(\\d+)(分钟前|小时前|天前|周前|个月前)$",
      "replacement": "$1 minutes/hours/days/weeks/months ago"
    },
    {
      "selector": ".content-card-wrapper .source",
      "pattern": "^来源",
      "replacement": "Source: ",
      "note": "Translate only fixed prefix; preserve author text verbatim"
    },
    {
      "selector": ".error,.ivu-message-content,.el-message__content",
      "pattern": "^请输入正确格式的(电话号码|电子邮件|网址)$",
      "replacement": "Enter a valid phone number/email address/website URL",
      "note": "Map fixed field names; do not treat text after the prefix as arbitrary replaceable user data"
    },
    {
      "selector": ".error,.ivu-message-content,.el-message__content",
      "pattern": "^最多只能添加5个(电话|电子邮件|网址|即时消息|地址)$",
      "replacement": "You can add up to 5 phone numbers/email addresses/websites/instant messaging accounts/addresses"
    }
  ],
  "notes": [
    "Use exact whole-text-node matches on the safe selector list; do not substring-replace across all page text.",
    "Exclude selectors take precedence. Do not modify contact names, group names, card titles, book names, authors, phone numbers, locations, URLs, editable values or submitted values even if they exactly match a dictionary key.",
    "Contact editor labels may use Chinese names as internal type identifiers and compare them to 生日/群组. Translate rendered text only; never alter Vue state or source string comparisons.",
    "Country and legal company name are fixed labels; registration identifiers should remain unchanged.",
    "Datepicker month/week labels should be rendered English by mapping their leaf text inside the datepicker only. Single Chinese numerals elsewhere may be user content.",
    "ContextualTranslations single weekday characters must never be copied to unrestricted global mappings. Their safe scope is contact datepicker .calendar-week."
  ],
