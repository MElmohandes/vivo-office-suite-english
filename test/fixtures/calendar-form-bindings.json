{
  "reminderInput": "require(require('path').join(__dirname,'ui-display.cjs')).reminderLabel(e.value.hasAlarm&&e.name||\"No reminder\")",
  "categoryOptionsGetter": "get categoryOptions(){return this.todoCategories.filter(e=>0!==e.visible).filter(e=>!e.defaultType||6===e.defaultType||p.hasTodoForCategory(e.guid,f.getBgColorByCategoryGuid(e.guid))).map(e=>({label:require(require('path').join(__dirname,'ui-display.cjs')).todoCategory(e),value:e.guid,colorValue:e.colorValue}))}",
