    "128.js": "require(require('path').join(__dirname,'ui-display.cjs')).timeZoneLabel({timeZoneID:t.timeZoneID,label:t.cityTimeZone?`${t.cityTimeZone}/(${t.summerTime})`:t.summerTime})",
    "130.js": "require(require('path').join(__dirname,'ui-display.cjs')).timeZoneLabel({timeZoneID:e.timeZoneID,label:e.cityTimeZone?`${e.cityTimeZone}/(${e.summerTime})`:e.summerTime})",
